BB18_R18c.sym_val =
fun s : Sym => match s with
               | 0 => 0
               | 1 => 1
               end
     : Sym -> nat

Arguments BB18_R18c.sym_val s%sym_scope
BB18_R18c.count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => BB18_R18c.sym_val x + count1 t
  end
     : list Sym -> nat

