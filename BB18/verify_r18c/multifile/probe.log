BB18_R18c.iter =
fix iter (X : Type) (n : nat) (g : X -> X) (x : X) {struct n} : X :=
  match n with
  | 0 => x
  | S n' => g (iter X n' g x)
  end
     : forall {X : Type}, nat -> (X -> X) -> X -> X

Arguments BB18_R18c.iter {X}%type_scope n%nat_scope g%function_scope x
BB18_R18c.f =
fix f (k : nat) : nat -> nat :=
  match k with
  | 0 => S
  | S k' => fun n : nat => BB18_R18c.iter n (f k') n
  end
     : nat -> nat -> nat

Arguments BB18_R18c.f (k _)%nat_scope
BB18_R18c.f_omega = fun n : nat => BB18_R18c.f n n
     : nat -> nat

Arguments BB18_R18c.f_omega n%nat_scope
BB18_R18c.f_wk =
fix f_wk (k : nat) : nat -> nat :=
  match k with
  | 0 => BB18_R18c.f_omega
  | S k' => fun n : nat => BB18_R18c.iter n (f_wk k') n
  end
     : nat -> nat -> nat

