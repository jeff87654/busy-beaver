BB18_R18c.ones =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N = BB18_R18c.count1 L + BB18_R18c.sym_val s + BB18_R18c.count1 R
     : Q * tape -> nat -> Prop

Arguments BB18_R18c.ones c N%nat_scope
BB18_R18c.halt
     : halts BB18_R18c.tm c0
BB18_R18c.score_exact
     : exists (a1 k1 b0 a2 j : nat) (c : Q * tape),
         a1 = BB18_R18c.hoc 0 2 7 /\
         a1 + 6 = 3 * S (S k1) /\
         b0 = BB18_R18c.iter 2 (BB18_R18c.ho 0) 7 /\
         a2 = BB18_R18c.hoc 1 (S k1) b0 /\
         a2 + 2 * (1 + S k1) + 2 = 3 * S j + 1 /\
         c0 -[ BB18_R18c.tm ]->* c /\
         halted BB18_R18c.tm c /\ BB18_R18c.ones c (2 * S j + 1)
BB18_R18c.sigma_lower_bound
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB18_R18c.tm ]->* c /\
         halted BB18_R18c.tm c /\
         BB18_R18c.ones c N /\
         BB18_R18c.f_w2 (2 * BB18_R18c.iter 9 BB18_R18c.f_omega 35) < N /\
         BB18_R18c.f_w2 (BB18_R18c.f_wk 1 (BB18_R18c.f 4 2)) < N
BB18_R18c.halt_tnf
     : halts BB18_R18c.tm_tnf c0
BB18_R18c.sigma_lower_bound_tnf
