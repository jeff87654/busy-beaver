BB18_R18c.h =
fix h (m x : nat) {struct m} : nat :=
  match m with
  | 0 => x + 4
  | S m' => BB18_R18c.iter (x + 2) (h m') 2
  end
     : nat -> nat -> nat

Arguments BB18_R18c.h (m x)%nat_scope
BB18_R18c.hc =
fix hc (m n x : nat) {struct n} : nat :=
  match n with
  | 0 => x
  | S n' => hc (S m) n' (BB18_R18c.h m x)
  end
     : nat -> nat -> nat -> nat

Arguments BB18_R18c.hc (m n x)%nat_scope
BB18_R18c.Gcy =
fun c y : nat =>
match y with
| 0 => match c with
       | 0 => 4
       | S c' => BB18_R18c.hc 1 c' 6 + 2 * c' + 4
       end
| 1 => BB18_R18c.hc 1 (S c) 7 + 2 * S c + 4
| S (S _) => BB18_R18c.hc 1 (S c) 11 + 2 * S c + 4
end
     : nat -> nat -> nat

Arguments BB18_R18c.Gcy (c y)%nat_scope
BB18_R18c.G = fun a : nat => BB18_R18c.Gcy (a / 3) (a mod 3)
     : nat -> nat

Arguments BB18_R18c.G a%nat_scope
BB18_R18c.ho =
fix ho (m a : nat) {struct m} : nat :=
  match m with
  | 0 => BB18_R18c.G a
  | S m' => BB18_R18c.iter (a + 1) (ho m') 15
  end
     : nat -> nat -> nat

Arguments BB18_R18c.ho (m a)%nat_scope
BB18_R18c.hoc =
fix hoc (m n a : nat) {struct n} : nat :=
  match n with
  | 0 => a
  | S n' => hoc (S m) n' (BB18_R18c.ho m a)
  end
     : nat -> nat -> nat -> nat

