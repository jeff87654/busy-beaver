parse_slot =
fun (str : String.string) (i j : nat) =>
let k := 7 * i + 3 * j in
match String.get k str with
| Some a =>
    match String.get (k + 1) str with
    | Some b =>
        match String.get (k + 2) str with
        | Some c =>
            match p_sym a with
            | Some s =>
                match p_dir b with
                | Some d =>
                    match p_st c with
                    | Some q => Some (s, d, q)
                    | None => None
                    end
                | None => None
                end
            | None => None
            end
        | None => None
        end
    | None => None
    end
| None => None
end
     : String.string -> nat -> nat -> option (Sym * dir * Q)

Arguments parse_slot str%string_scope (i j)%nat_scope
