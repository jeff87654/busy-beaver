BB25_W2PR_score.onesN =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N =
  BB25_W2PR_score.count1 L + BB25_W2PR_score.sym_val s +
  BB25_W2PR_score.count1 R
     : Q * tape -> nat -> Prop

