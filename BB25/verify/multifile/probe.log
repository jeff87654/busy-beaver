BB21_B21_absdef.iter =
fix iter (X : Type) (n : nat) (g : X -> X) (x : X) {struct n} : X :=
  match n with
  | 0 => x
  | S n' => g (iter X n' g x)
  end
     : forall {X : Type}, nat -> (X -> X) -> X -> X

Arguments BB21_B21_absdef.iter {X}%type_scope n%nat_scope g%function_scope x
BB21_B21_absdef.h =
fix h (m x : nat) {struct m} : nat :=
  match m with
  | 0 => x + 4
  | S m' => BB21_B21_absdef.iter (x + 3) (h m') 1
  end
     : nat -> nat -> nat

Arguments BB21_B21_absdef.h (m x)%nat_scope
