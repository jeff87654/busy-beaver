knuth =
fix knuth (n a b : nat) {struct n} : nat :=
  match n with
  | 0 => a * b
  | S n' => PeanoNat.Nat.iter b (knuth n' a) 1
  end
     : nat -> nat -> nat -> nat

Arguments knuth (n a b)%nat_scope
f_omega = fun n : nat => knuth (S n) 2 (n + 3)
     : nat -> nat

Arguments f_omega n%nat_scope
f_omega2 = fun n : nat => f_omega (f_omega n)
     : nat -> nat

Arguments f_omega2 n%nat_scope
f_omega1 = fun n : nat => PeanoNat.Nat.iter n f_omega n
     : nat -> nat

Arguments f_omega1 n%nat_scope
