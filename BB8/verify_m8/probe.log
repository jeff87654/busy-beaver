Sim.Rel =
fun (c8 : Sim.cfg8)
  (c9 : BB92.BB92.Q *
        (Stream BB92.BB92.Sym * BB92.BB92.Sym * Stream BB92.BB92.Sym)) =>
exists (q : state) (Ll : list sym) (s : sym) (Rr : list sym),
  c8 = (q, (Ll *> const 0, s, Rr *> const 0)) /\
  c9 =
  (Sim.stmap q,
   (List.map Sim.symmap Ll *> const BB92.S0, Sim.symmap s,
    List.map Sim.symmap Rr *> const BB92.S0))
     : Sim.cfg8 ->
