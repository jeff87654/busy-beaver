Tm8.ones =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N = Tm8.count1 L + Tm8.sym_val s + Tm8.count1 R
     : Q * tape -> nat -> Prop

Arguments Tm8.ones c N%nat_scope
Tm8.count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => Tm8.sym_val x + count1 t
  end
     : list Sym -> nat

Arguments Tm8.count1 xs%list_scope
Tm8.sym_val =
fun s : Sym => match s with
               | 0 => 0
               | 1 => 1
               end
     : Sym -> nat

Arguments Tm8.sym_val s%sym_scope
Score.f =
fix f (k : nat) : nat -> nat :=
  match k with
  | 0 => S
  | S k' => fun n : nat => Abs.iter n (f k') n
  end
     : nat -> nat -> nat

Arguments Score.f (k _)%nat_scope
Score.f_omega = fun n : nat => Score.f n n
     : nat -> nat

Arguments Score.f_omega n%nat_scope
FArith.f_w1 = fun n : nat => Abs.iter n Score.f_omega n
     : nat -> nat

Arguments FArith.f_w1 n%nat_scope
