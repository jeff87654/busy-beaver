Abs.arrow =
fix arrow (k a b : nat) {struct k} : nat :=
  match k with
  | 0 => a * b
  | S k' => PeanoNat.Nat.iter b (arrow k' a) 1
  end
     : nat -> nat -> nat -> nat

Arguments Abs.arrow (k a b)%nat_scope
BB8_champ35_bound.arrow =
