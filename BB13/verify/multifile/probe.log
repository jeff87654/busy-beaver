BB13_M13_bound.ones =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N =
  BB13_M13_bound.count1 L + BB13_M13_bound.sym_val s +
  BB13_M13_bound.count1 R
     : Q * tape -> nat -> Prop

