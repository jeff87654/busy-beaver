U =
fix U (j : nat) : nat -> nat :=
  match j with
  | 0 => fun x : nat => dbl (2 * x + 2) 0
  | S i => fun x : nat => iter (2 * x + 2) (U i) 0
  end
     : nat -> nat -> nat

Arguments U (j _)%nat_scope
iter =
fix iter (n : nat) (g : nat -> nat) (x : nat) {struct n} : nat :=
  match n with
  | 0 => x
  | S n' => g (iter n' g x)
  end
     : nat -> (nat -> nat) -> nat -> nat

Arguments iter n%nat_scope g%function_scope x%nat_scope
dbl =
fix dbl (a b : nat) {struct a} : nat :=
  match a with
  | 0 => b
  | S a' => dbl a' (2 * b + 2)
  end
     : nat -> nat -> nat

Arguments dbl (a b)%nat_scope
