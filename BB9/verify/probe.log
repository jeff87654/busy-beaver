halts =
fun (tm : TM) (c0 : Q * tape) => exists n : nat, halts_in tm c0 n
     : TM -> Q * tape -> Prop

Arguments halts tm c0
halts_in =
fun (tm : TM) (c : Q * tape) (n : nat) =>
exists ch : Q * tape, c -[ tm ]->> n / ch /\ halted tm ch
     : TM -> Q * tape -> nat -> Prop

Arguments halts_in tm c n%nat_scope
halted =
fun (tm : TM) (c : Q * tape) =>
let (q, p) := c in let (p0, _) := p in let (_, s) := p0 in tm (q, s) = None
     : TM -> Q * tape -> Prop

Arguments halted tm c
Inductive step (tm : TM) : Q * tape -> Q * tape -> Prop :=
    step_left : forall (q q' : Q) (s s' : Sym) (l r : side),
                tm (q, s) = Some (s', L, q') ->
                (q, (l, s, r)) -[ tm ]-> (q', move_left (l, s', r))
  | step_right : forall (q q' : Q) (s s' : Sym) (l r : side),
                 tm (q, s) = Some (s', R, q') ->
                 (q, (l, s, r)) -[ tm ]-> (q', move_right (l, s', r)).

Arguments step tm _ _
Arguments step_left {tm q q'} {s s'}%sym_scope {l r} _
Arguments step_right {tm q q'} {s s'}%sym_scope {l r} _
