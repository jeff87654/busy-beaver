Defs.tm7 =
fun pat : Q * Sym =>
match pat with
| (A, 0) => Some (1, R, B)
| (B, 1) => Some (1, L, F)
| (C, 0) => Some (1, R, D)
| (C, 1) => Some (0, L, B)
| (D, 0) => Some (1, R, A)
| (D, 1) => Some (1, L, E)
| (E, 0) => Some (1, L, H)
| (E, 1) => Some (0, L, C)
| (F, 0) => Some (1, R, G)
| (F, 1) => Some (1, L, D)
| (G, 0) => Some (0, R, G)
| (G, 1) => Some (0, R, F)
| (H, 0) => Some (0, L, I)
| (H, 1) => None
| (B, 0) | (I, 0) => Some (1, L, C)
| _ => Some (0, R, A)
end
     : TM
eq_refl : Defs.tm7 (A, 0) = Some (1, R, B)
