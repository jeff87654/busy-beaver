Statement.c7_table
     : length Statement.c7_string = 62 /\
       (forall (q : Q) (s : Sym),
        Defs.tm7 (q, s) =
        Statement.parse_slot Statement.c7_string (Statement.st_idx q)
          (Statement.sym_idx s))
eq_refl : Statement.parse_slot Statement.c7_string 7 1 = None
     : Statement.parse_slot Statement.c7_string 7 1 = None
Defs.ones =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N = Defs.count1 L + Defs.sym_val s + Defs.count1 R
     : Q * tape -> nat -> Prop

Arguments Defs.ones c N%nat_scope
Defs.count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => Defs.sym_val x + count1 t
  end
     : list Sym -> nat

Arguments Defs.count1 xs%list_scope
Defs.sym_val =
fun s : Sym => match s with
               | 0 => 0
               | 1 => 1
               end
     : Sym -> nat

Arguments Defs.sym_val s%sym_scope
Defs.iter =
fix iter (n : nat) (g : nat -> nat) (x : nat) {struct n} : nat :=
  match n with
  | 0 => x
  | S n' => g (iter n' g x)
  end
     : nat -> (nat -> nat) -> nat -> nat

Arguments Defs.iter n%nat_scope g%function_scope x%nat_scope
Defs.arrow =
fix arrow (k a b : nat) {struct k} : nat :=
  match k with
  | 0 => a * b
  | S k' => Nat.iter b (arrow k' a) 1
  end
     : nat -> nat -> nat -> nat

Arguments Defs.arrow (k a b)%nat_scope
Defs.f =
fix f (k : nat) : nat -> nat :=
  match k with
  | 0 => S
  | S k' => fun n : nat => Defs.iter n (f k') n
  end
     : nat -> nat -> nat

Arguments Defs.f (k _)%nat_scope
Defs.f_omega = fun n : nat => Defs.f n n
     : nat -> nat

Arguments Defs.f_omega n%nat_scope
Statement.c7_halts
     : halts Defs.tm7 c0
Statement.c7_lower
     : forall (c : Q * tape) (N : nat),
       c0 -[ Defs.tm7 ]->* c ->
       halted Defs.tm7 c ->
       Defs.ones c N ->
       Defs.f_omega
         (Defs.f_omega
            (Defs.f_omega (Defs.f_omega (6 * Defs.arrow 13 2 3 + 3)))) < N
Statement.c7_beats_m8_bound
     : forall (c : Q * tape) (N : nat),
       c0 -[ Defs.tm7 ]->* c ->
       halted Defs.tm7 c ->
       Defs.ones c N ->
       Defs.f_omega (Defs.f_omega (6 * Defs.arrow 13 2 3 + 3)) < N
