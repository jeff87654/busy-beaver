Statement.h003_lower
     : forall (c : Q * tape) (N : nat),
       c0 -[ Defs.tmh ]->* c ->
       halted Defs.tmh c ->
       Defs.ones c N ->
       Defs.f_omega
         (Defs.f_omega
            (Defs.f_omega
               (Defs.f_omega
                  (Defs.f_omega (Defs.f_omega (6 * Defs.arrow 13 2 3 + 2)))))) <
       N
