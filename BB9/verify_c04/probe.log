halted =
fun (tm : TM) (c : Q * tape) =>
let (q, p) := c in let (p0, _) := p in let (_, s) := p0 in tm (q, s) = None
     : TM -> Q * tape -> Prop

Arguments halted tm c
K31_Abs.sym_val =
fun s : Sym => match s with
               | 0 => 0
               | 1 => 1
               end
     : Sym -> nat

Arguments K31_Abs.sym_val s%sym_scope
K31_Abs.count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => K31_Abs.sym_val x + count1 t
  end
     : list Sym -> nat

Arguments K31_Abs.count1 xs%list_scope
K31_Abs.ones =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N = K31_Abs.count1 L + K31_Abs.sym_val s + K31_Abs.count1 R
     : Q * tape -> nat -> Prop

Arguments K31_Abs.ones c N%nat_scope
Score.f =
fix f (k : nat) : nat -> nat :=
  match k with
  | 0 => S
  | S k' => fun n : nat => Abs.iter n (f k') n
  end
     : nat -> nat -> nat

Arguments Score.f (k _)%nat_scope
Score.f_omega = fun n : nat => Score.f n n
     : nat -> nat

Arguments Score.f_omega n%nat_scope
Final.c04_halts : halts Base.tm c0
