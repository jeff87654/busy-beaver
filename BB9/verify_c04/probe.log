ScoreEnd.c04_sigma_lower_bound
:
exists (c : Q * tape) (N : nat),
  c0 -[ Base.tm ]->* c /\
  halted Base.tm c /\
  K31_Abs.ones c N /\ Score.f_omega (Score.f_omega (465 * 1000 + 9)) < N
     : exists (c : Q * tape) (N : nat),
         c0 -[ Base.tm ]->* c /\
         halted Base.tm c /\
         K31_Abs.ones c N /\
         Score.f_omega (Score.f_omega (465 * 1000 + 9)) < N
