n1_score_exact
:
exists (c : Q * tape) (f k w : nat),
  c0 -[ N1.tm ]->* c /\
  halted N1.tm c /\
  ones c (2 * w + f + 3 * k + 22) /\
  iter (2 * ((3 * arrow 37 2 3 - 13) / 7) + 1) (fun n : nat => arrow n 2 4)
    34 <= w
     : exists (c : Q * tape) (f k w : nat),
         c0 -[ N1.tm ]->* c /\
         halted N1.tm c /\
         ones c (2 * w + f + 3 * k + 22) /\
         iter (2 * ((3 * arrow 37 2 3 - 13) / 7) + 1)
           (fun n : nat => arrow n 2 4) 34 <= w
n1_sigma_lower_bound
:
exists (c : Q * tape) (N : nat),
  c0 -[ N1.tm ]->* c /\
  halted N1.tm c /\
  ones c N /\
  iter ((6 * arrow 37 2 3 - 19) / 7) (fun x : nat => arrow (x + 1) 2 3) 33 <
  N
     : exists (c : Q * tape) (N : nat),
         c0 -[ N1.tm ]->* c /\
         halted N1.tm c /\
         ones c N /\
         iter ((6 * arrow 37 2 3 - 19) / 7)
           (fun x : nat => arrow (x + 1) 2 3) 33 < N
n1_beats_M3_bound
:
exists (c : Q * tape) (N : nat),
  c0 -[ N1.tm ]->* c /\
  halted N1.tm c /\
  ones c N /\
  arrow (4 * arrow 37 2 3 + 41) 2
    (arrow (4 * arrow 37 2 3 + 39) 2 (arrow (4 * arrow 37 2 3 + 35) 2 5)) < N
     : exists (c : Q * tape) (N : nat),
         c0 -[ N1.tm ]->* c /\
         halted N1.tm c /\
         ones c N /\
         arrow (4 * arrow 37 2 3 + 41) 2
           (arrow (4 * arrow 37 2 3 + 39) 2
              (arrow (4 * arrow 37 2 3 + 35) 2 5)) < N
n1_beats_champion
:
exists (cc : Q * tape) (Nc : nat) (co : Q * tape) 
(No : nat),
  c0 -[ Champion10.tm ]->* cc /\
  halted Champion10.tm cc /\
  ones cc Nc /\
  c0 -[ N1.tm ]->* co /\ halted N1.tm co /\ ones co No /\ Nc + 1 < No + 1
     : exists (cc : Q * tape) (Nc : nat) (co : Q * tape) 
       (No : nat),
         c0 -[ Champion10.tm ]->* cc /\
         halted Champion10.tm cc /\
         ones cc Nc /\
         c0 -[ N1.tm ]->* co /\
         halted N1.tm co /\ ones co No /\ Nc + 1 < No + 1
n1_beats_lead
:
exists (cl : Q * tape) (Nl : nat) (co : Q * tape) 
(No : nat),
  c0 -[ Lead10.tm ]->* cl /\
  halted Lead10.tm cl /\
  ones cl Nl /\
  c0 -[ N1.tm ]->* co /\ halted N1.tm co /\ ones co No /\ Nl + 1 < No + 1
     : exists (cl : Q * tape) (Nl : nat) (co : Q * tape) 
       (No : nat),
         c0 -[ Lead10.tm ]->* cl /\
         halted Lead10.tm cl /\
         ones cl Nl /\
         c0 -[ N1.tm ]->* co /\
         halted N1.tm co /\ ones co No /\ Nl + 1 < No + 1
n1_fgh_level
:
exists (c : Q * tape) (N : nat),
  c0 -[ N1.tm ]->* c /\
  halted N1.tm c /\
  ones c N /\
  f_omega1 ((3 * arrow 37 2 3 - 13) / 7 - 2) < N <
  f_omega1 (6 * arrow 37 2 3)
     : exists (c : Q * tape) (N : nat),
         c0 -[ N1.tm ]->* c /\
         halted N1.tm c /\
         ones c N /\
         f_omega1 ((3 * arrow 37 2 3 - 13) / 7 - 2) < N <
         f_omega1 (6 * arrow 37 2 3)
n1_fgh_lower_64
:
exists (c : Q * tape) (N : nat),
