halts =
fun (tm : TM) (c0 : Q * tape) => exists n : nat, halts_in tm c0 n
     : TM -> Q * tape -> Prop

Arguments halts tm c0
halts_in =
fun (tm : TM) (c : Q * tape) (n : nat) =>
exists ch : Q * tape, c -[ tm ]->> n / ch /\ halted tm ch
     : TM -> Q * tape -> nat -> Prop

Arguments halts_in tm c n%nat_scope
halted =
fun (tm : TM) (c : Q * tape) =>
let (q, p) := c in let (p0, _) := p in let (_, s) := p0 in tm (q, s) = None
     : TM -> Q * tape -> Prop

Arguments halted tm c
Inductive step (tm : TM) : Q * tape -> Q * tape -> Prop :=
    step_left : forall (q q' : Q) (s s' : Sym) (l r : side),
                tm (q, s) = Some (s', L, q') ->
                (q, (l, s, r)) -[ tm ]-> (q', move_left (l, s', r))
  | step_right : forall (q q' : Q) (s s' : Sym) (l r : side),
                 tm (q, s) = Some (s', R, q') ->
                 (q, (l, s, r)) -[ tm ]-> (q', move_right (l, s', r)).

Arguments step tm _ _
Arguments step_left {tm q q'} {s s'}%sym_scope {l r} _
Arguments step_right {tm q q'} {s s'}%sym_scope {l r} _
c0 = (q0, tape0)
     : Q * tape
tape0 = (const s0, s0, const s0)
     : tape
ones =
fun (c : state * tape) (N : nat) =>
exists (q : state) (Ls Rs : list Sym) (s : Sym),
  c = (q, (Ls *> const 0, s, Rs *> const 0)) /\
  N = count1 Ls + sym_val s + count1 Rs
     : state * tape -> nat -> Prop

Arguments ones c N%nat_scope
count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => sym_val x + count1 t
  end
     : list Sym -> nat

Arguments count1 xs%list_scope
sym_val = fun s : Sym => match s with
                         | 0 => 0
                         | 1 => 1
                         end
     : Sym -> nat

Arguments sym_val s%sym_scope
N1.arrow =
fix arrow (k a b : nat) {struct k} : nat :=
  match k with
  | 0 => a * b
  | S k' => Nat.iter b (arrow k' a) 1
  end
     : nat -> nat -> nat -> nat

Arguments N1.arrow (k a b)%nat_scope
N1.iter =
fix iter (n : nat) (g : nat -> nat) (x : nat) {struct n} : nat :=
  match n with
  | 0 => x
  | S n' => g (iter n' g x)
  end
     : nat -> (nat -> nat) -> nat -> nat

Arguments N1.iter n%nat_scope g%function_scope x%nat_scope
N1.fgh =
fix fgh (k n : nat) {struct k} : nat :=
  match k with
  | 0 => S n
  | S k' => Nat.iter n (fgh k') n
  end
     : nat -> nat -> nat

Arguments N1.fgh (k n)%nat_scope
N1.f_omega = fun n : nat => N1.fgh n n
     : nat -> nat

Arguments N1.f_omega n%nat_scope
N1.f_omega1 = fun n : nat => Nat.iter n N1.f_omega n
     : nat -> nat

Arguments N1.f_omega1 n%nat_scope
N1.up3 =
fix up3 (k n : nat) {struct k} : nat :=
  match k with
  | 0 => 3 * n
  | S k' => Nat.iter n (up3 k') 1
  end
     : nat -> nat -> nat

Arguments N1.up3 (k n)%nat_scope
N1.graham_g =
fix graham_g (k : nat) : nat :=
  match k with
  | 0 => 4
  | S k' => N1.up3 (graham_g k') 3
  end
     : nat -> nat

Arguments N1.graham_g k%nat_scope
N1.Graham = N1.graham_g 64
     : nat
