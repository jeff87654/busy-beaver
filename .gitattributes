# Keep the proof files byte-identical on every platform (their SHA-256 is recorded in sha256.txt).
*.v text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.md text eol=lf
_CoqProject text eol=lf
*.tm text eol=lf
# PA/goldbach: check.py compares the frozen machine files with their sha256 byte for byte, and some of them
# (spec_pa.py and four of its imports) have CRLF line endings. Store and check out these files unconverted.
PA/goldbach/machine/** -text
