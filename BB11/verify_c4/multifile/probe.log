BB11_C4_cmp.beats_M11b_score
     : exists NM : nat,
         (exists c : Q * tape,
            c0 -[ BB11_M11b.tm ]->* c /\
            halted BB11_M11b.tm c /\ BB11_M11b_fgh.ones c NM) /\
         (exists (c : Q * tape) (n : nat),
