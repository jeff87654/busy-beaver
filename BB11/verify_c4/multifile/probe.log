BB12_M12_bound.ones =
fun
  (c : BB122.BB122.Q *
       (Stream BB122.BB122.Sym * BB122.BB122.Sym * Stream BB122.BB122.Sym))
  (N : nat) =>
exists
  (q : BB122.BB122.Q) (L R : list BB122.BB122.Sym) 
(s : BB122.BB122.Sym),
  c = (q, (L *> const BB122.S0, s, R *> const BB122.S0)) /\
  N =
  BB12_M12_bound.count1 L + BB12_M12_bound.sym_val s +
  BB12_M12_bound.count1 R
     : BB122.BB122.Q *
       (Stream BB122.BB122.Sym * BB122.BB122.Sym * Stream BB122.BB122.Sym) ->
       nat -> Prop

