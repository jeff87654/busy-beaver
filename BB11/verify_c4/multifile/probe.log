BB11_C4.sym_val =
fun s : Sym => match s with
               | 0 => 0
               | 1 => 1
               end
     : Sym -> nat

Arguments BB11_C4.sym_val s%sym_scope
BB11_C4.count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => BB11_C4.sym_val x + count1 t
  end
     : list Sym -> nat

Arguments BB11_C4.count1 xs%list_scope
BB11_C4.ones =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N = BB11_C4.count1 L + BB11_C4.sym_val s + BB11_C4.count1 R
     : Q * tape -> nat -> Prop

Arguments BB11_C4.ones c N%nat_scope
BB11_M11b_fgh.ones =
