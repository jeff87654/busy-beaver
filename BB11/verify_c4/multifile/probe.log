         halted BB11_C4.tm c /\
         BB11_C4.ones c n /\ fst BB12_M12.pb2 + snd BB12_M12.pb2 / 2 + 3 < n
BB11_C4_vs_M12.beats_M12_score
     : exists NM : nat,
         (exists
            c : BB122.BB122.Q *
                (Stream BB122.BB122.Sym * BB122.BB122.Sym *
                 Stream BB122.BB122.Sym),
            Individual122.Individual122.Permute.Flip.Compute.TM.evstep
