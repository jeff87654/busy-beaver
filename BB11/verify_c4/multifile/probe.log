BB11_C4.iter =
fix iter (X : Type) (n : nat) (g : X -> X) (x : X) {struct n} : X :=
  match n with
  | 0 => x
  | S n' => g (iter X n' g x)
  end
     : forall {X : Type}, nat -> (X -> X) -> X -> X

Arguments BB11_C4.iter {X}%type_scope n%nat_scope g%function_scope x
BB11_C4.W =
fix W (j b : nat) {struct j} : nat :=
  match j with
  | 0 => b + 3
  | S j' => BB11_C4.iter (S b) (W j') 2
  end
     : nat -> nat -> nat

Arguments BB11_C4.W (j b)%nat_scope
BB11_C4_bound.f =
fix f (k : nat) : nat -> nat :=
  match k with
  | 0 => S
  | S k' => fun n : nat => BB11_C4.iter n (f k') n
  end
     : nat -> nat -> nat

Arguments BB11_C4_bound.f (k _)%nat_scope
BB11_C4_bound.f_omega = fun n : nat => BB11_C4_bound.f n n
     : nat -> nat

