BB11_C4_bound.sigma_lower_bound
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB11_C4.tm ]->* c /\
         halted BB11_C4.tm c /\
         BB11_C4.ones c N /\
         BB11_C4_bound.f_omega2
           (BB11_C4_bound.f_omega2 (BB11_C4_bound.f 5 34)) < N
