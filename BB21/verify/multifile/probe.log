BB21_B21_score.tet =
fix tet (n : nat) : nat := match n with
                           | 0 => 1
                           | S n' => 4 ^ tet n'
                           end
     : nat -> nat

Arguments BB21_B21_score.tet n%nat_scope
BB21_B21_score.sym_val =
fun s : Sym => match s with
               | 0 => 0
               | 1 => 1
               end
     : Sym -> nat

Arguments BB21_B21_score.sym_val s%sym_scope
BB21_B21_score.count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => BB21_B21_score.sym_val x + count1 t
  end
     : list Sym -> nat

Arguments BB21_B21_score.count1 xs%list_scope
BB21_B21_score.onesN =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N =
  BB21_B21_score.count1 L + BB21_B21_score.sym_val s +
  BB21_B21_score.count1 R
     : Q * tape -> nat -> Prop

Arguments BB21_B21_score.onesN c N%nat_scope
BB21_B21.halt
     : halts BB21_B21.tm c0
BB21_B21.sigma_lower_bound
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB21_B21.tm ]->* c /\
         halted BB21_B21.tm c /\
         BB21_B21_score.onesN c N /\ BB21_B21_score.tet 341 < N
BB21_B21_run.abstract_halt
     : exists bs : list (list nat),
         BB21_B21_proc.star BB21_B21_absdef.refill21 BB21_B21_run.S3 bs /\
         BB21_B21_absdef.astepG BB21_B21_absdef.refill21 bs =
         BB21_B21_absdef.Halt
