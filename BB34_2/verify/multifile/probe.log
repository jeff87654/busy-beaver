Ord.fs =
fix fs (x : Ord.ord) (n : nat) {struct x} : Ord.ord :=
  match x with
  | Ord.oz => Ord.oz
  | Ord.ow a Ord.oz =>
      match a with
      | Ord.oz => Ord.oz
      | Ord.ow _ _ =>
          match Ord.opred a with
          | Some a' => Ord.orep a' n Ord.oz
          | None => Ord.ow (fs a n) Ord.oz
          end
      end
  | Ord.ow a (Ord.ow _ _ as b) => Ord.ow a (fs b n)
  end
     : Ord.ord -> nat -> Ord.ord

Arguments Ord.fs x n%nat_scope
Inductive fgh : Ord.ord -> nat -> nat -> Prop :=
    fgh_zero : forall n : nat, Ord.fgh Ord.oz n (S n)
  | fgh_succ : forall (x b : Ord.ord) (n m : nat),
               Ord.okind x = Ord.KSucc b -> Ord.fghi b n n m -> Ord.fgh x n m
  | fgh_lim : forall (x : Ord.ord) (n m : nat),
              Ord.okind x = Ord.KLim ->
              Ord.fgh (Ord.fs x n) n m -> Ord.fgh x n m
  with fghi : Ord.ord -> nat -> nat -> nat -> Prop :=
    fghi_O : forall (b : Ord.ord) (y : nat), Ord.fghi b 0 y y
  | fghi_S : forall (b : Ord.ord) (k y y1 m : nat),
             Ord.fgh b y y1 -> Ord.fghi b k y1 m -> Ord.fghi b (S k) y m.

Arguments Ord.fgh _ (_ _)%nat_scope
Arguments Ord.fgh_zero n%nat_scope
Arguments Ord.fgh_succ x b (n m)%nat_scope _ _
Arguments Ord.fgh_lim x (n m)%nat_scope _ _
Arguments Ord.fghi _ (_ _ _)%nat_scope
Arguments Ord.fghi_O b y%nat_scope
Arguments Ord.fghi_S b (k y y1 m)%nat_scope _ _
Ord.FGH =
fun (x : Ord.ord) (n : nat) =>
match Ord.nf_dec x with
| Specif.left H => proj1_sig (Ord.fgh_total x H n)
| No => 0
end
     : Ord.ord -> nat -> nat

Arguments Ord.FGH x n%nat_scope
Ord.tower =
fix tower (k : nat) : Ord.ord :=
  match k with
  | 0 => Ord.one
  | S k' => Ord.opow (tower k')
  end
     : nat -> Ord.ord

Arguments Ord.tower k%nat_scope
Ord.powtower =
fix powtower (j : nat) (y : Ord.ord) {struct j} : Ord.ord :=
  match j with
  | 0 => y
  | S j' => Ord.opow (powtower j' y)
  end
     : nat -> Ord.ord -> Ord.ord

Arguments Ord.powtower j%nat_scope y
Ord.opow = fun a : Ord.ord => Ord.ow a Ord.oz
     : Ord.ord -> Ord.ord

Arguments Ord.opow a
Ord.ofin = fun k : nat => Ord.orep Ord.oz k Ord.oz
     : nat -> Ord.ord

Arguments Ord.ofin k%nat_scope
Ord.orep =
fix orep (a : Ord.ord) (k : nat) (y : Ord.ord) {struct k} : Ord.ord :=
  match k with
  | 0 => y
  | S k' => Ord.ow a (orep a k' y)
  end
     : Ord.ord -> nat -> Ord.ord -> Ord.ord

Arguments Ord.orep a k%nat_scope y
Ord.one = Ord.ow Ord.oz Ord.oz
     : Ord.ord
Hardy.HH =
fun (x : Ord.ord) (n : nat) =>
match Ord.nf_dec x with
| Specif.left H => proj1_sig (Hardy.hardy_total x H n)
| No => 0
end
     : Ord.ord -> nat -> nat

Arguments Hardy.HH x n%nat_scope
BB34_halt.hs0 = HydraOrd.plug BB34_halt.sp0 []
     : list HydraOrd.tree
BB34_game.ones =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N = BB34_game.count1 L + BB34_game.sym_val s + BB34_game.count1 R
     : Q * tape -> nat -> Prop

Arguments BB34_game.ones c N%nat_scope
BB34_game.count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => BB34_game.sym_val x + count1 t
  end
     : list Sym -> nat

Arguments BB34_game.count1 xs%list_scope
BB34_game.sym_val =
fun s : Sym => match s with
               | 0 => 0
               | 1 => 1
               end
     : Sym -> nat

Arguments BB34_game.sym_val s%sym_scope
BB34_halt.halt
     : halts BB34_tm.tm c0
BB34_halt.hardy_bound
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB34_tm.tm ]->* c /\
         halted BB34_tm.tm c /\
         BB34_game.ones c N /\
         Hardy.HH (HydraOrd.olist BB34_halt.hs0) 5 <= N + 2
BB34_halt.x0_eq
     : HydraOrd.olist BB34_halt.hs0 = Ord.powtower 6 (Ord.ofin 4)
BB34_bound.hardy_score
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB34_tm.tm ]->* c /\
         halted BB34_tm.tm c /\
         BB34_game.ones c N /\
         Ord.FGH (Ord.powtower 5 (Ord.ofin 4)) 5 <= N + 2
BB34_bound.sigma_lower_bound_w6_4
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB34_tm.tm ]->* c /\
         halted BB34_tm.tm c /\
         BB34_game.ones c N /\ Ord.FGH (Ord.tower 6) 4 < N
BB34_bound.sigma_lower_bound_w6
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB34_tm.tm ]->* c /\
         halted BB34_tm.tm c /\
         BB34_game.ones c N /\ Ord.FGH (Ord.tower 6) 3 < N
BB34_bound.sigma_lower_bound
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB34_tm.tm ]->* c /\
         halted BB34_tm.tm c /\
         BB34_game.ones c N /\ Ord.FGH (Ord.tower 4) 3 < N
