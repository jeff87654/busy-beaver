Ord.FGH =
fun (x : Ord.ord) (n : nat) =>
match Ord.nf_dec x with
| left H => proj1_sig (Ord.fgh_total x H n)
| right _ => 0
end
     : Ord.ord -> nat -> nat

Arguments Ord.FGH x n%nat_scope
Ord.fin_fgh =
fix fin_fgh (k n : nat) {struct k} : nat :=
  match k with
  | 0 => S n
  | S k' => PeanoNat.Nat.iter n (fin_fgh k') n
  end
     : nat -> nat -> nat

Arguments Ord.fin_fgh (k n)%nat_scope
KnuthFGH.kn =
fix kn (n a b : nat) {struct n} : nat :=
  match n with
  | 0 => a * b
  | S n' => PeanoNat.Nat.iter b (kn n' a) 1
  end
     : nat -> nat -> nat -> nat

Arguments KnuthFGH.kn (n a b)%nat_scope
BB34_run.sigma = 2 * BB34_run.g15 + 18
     : nat
KnuthFGH.fin_lower
     : forall k x : nat, 1 <= x -> KnuthFGH.kn k 2 x <= Ord.fin_fgh (S k) x
KnuthFGH.fin_upper
     : forall k x : nat,
       1 <= k -> 4 <= x -> Ord.fin_fgh (S k) x <= KnuthFGH.kn k 2 (3 * x)
KnuthFGH.fw_le_F
     : forall n : nat,
       4 <= n -> Ord.FGH Ord.omega n <= KnuthFGH.kn (S n) 2 (n + 3)
KnuthFGH.window_kn6
     : forall L : nat,
       4 <= L ->
       Ord.FGH Ord.omega L < KnuthFGH.kn L 2 6 + L < Ord.FGH Ord.omega (S L)
