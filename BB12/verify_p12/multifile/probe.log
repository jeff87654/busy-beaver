BB12_P12.iter =
fix iter (X : Type) (n : nat) (g : X -> X) (x : X) {struct n} : X :=
  match n with
  | 0 => x
  | S n' => g (iter X n' g x)
  end
     : forall {X : Type}, nat -> (X -> X) -> X -> X

Arguments BB12_P12.iter {X}%type_scope n%nat_scope g%function_scope x
BB12_P12.W =
fix W (j b : nat) {struct j} : nat :=
  match j with
  | 0 => b + 3
  | S j' => BB12_P12.iter (S b) (W j') 2
  end
     : nat -> nat -> nat

Arguments BB12_P12.W (j b)%nat_scope
BB12_P12.Be =
fun '(q, u) => (q - 1 + u / 2, BB12_P12.W (q - 1) 1 + 2)
     : nat * nat -> nat * nat

Arguments BB12_P12.Be qu
BB12_P12.Rd =
fun '(p, u) =>
BB12_P12.iter ((BB12_P12.W p u + 1) / 2) BB12_P12.Be
  (p - 1, BB12_P12.W (p - 1) 1 + 2)
     : nat * nat -> nat * nat

Arguments BB12_P12.Rd pu
BB12_P12.BigP =
fun D : nat =>
BB12_P12.iter ((D - 2) / 2) BB12_P12.Rd (7, BB12_P12.W 4 1 + 2)
     : nat -> nat * nat

Arguments BB12_P12.BigP D%nat_scope
BB12_P12.Big =
fun D : nat => fst (BB12_P12.BigP D) + snd (BB12_P12.BigP D) / 2 + 1
     : nat -> nat

Arguments BB12_P12.Big D%nat_scope
BB12_P12_bound.f =
fix f (k : nat) : nat -> nat :=
  match k with
  | 0 => S
  | S k' => fun n : nat => BB12_P12.iter n (f k') n
  end
     : nat -> nat -> nat

Arguments BB12_P12_bound.f (k _)%nat_scope
BB12_P12_bound.f_omega = fun n : nat => BB12_P12_bound.f n n
     : nat -> nat

Arguments BB12_P12_bound.f_omega n%nat_scope
BB12_P12_bound.f_omega1 =
fun n : nat => BB12_P12.iter n BB12_P12_bound.f_omega n
     : nat -> nat

Arguments BB12_P12_bound.f_omega1 n%nat_scope
BB12_P12_bound.f_omega2 =
fun n : nat => BB12_P12.iter n BB12_P12_bound.f_omega1 n
     : nat -> nat

Arguments BB12_P12_bound.f_omega2 n%nat_scope
BB12_P12.sym_val =
fun s : Sym => match s with
               | 0 => 0
               | 1 => 1
               end
     : Sym -> nat

Arguments BB12_P12.sym_val s%sym_scope
BB12_P12.count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => BB12_P12.sym_val x + count1 t
  end
     : list Sym -> nat

Arguments BB12_P12.count1 xs%list_scope
BB12_P12.ones =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N = BB12_P12.count1 L + BB12_P12.sym_val s + BB12_P12.count1 R
     : Q * tape -> nat -> Prop

