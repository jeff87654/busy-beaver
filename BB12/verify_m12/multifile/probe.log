BB12_M12.iter =
fix iter (X : Type) (n : nat) (g : X -> X) (x : X) {struct n} : X :=
  match n with
  | 0 => x
  | S n' => g (iter X n' g x)
  end
     : forall {X : Type}, nat -> (X -> X) -> X -> X

Arguments BB12_M12.iter {X}%type_scope n%nat_scope g%function_scope x
BB12_M12_bound.f =
fix f (k : nat) : nat -> nat :=
  match k with
  | 0 => S
  | S k' => fun n : nat => BB12_M12.iter n (f k') n
  end
     : nat -> nat -> nat

Arguments BB12_M12_bound.f (k _)%nat_scope
BB12_M12_bound.f_omega = fun n : nat => BB12_M12_bound.f n n
     : nat -> nat

Arguments BB12_M12_bound.f_omega n%nat_scope
BB12_M12_bound.f_omega1 =
