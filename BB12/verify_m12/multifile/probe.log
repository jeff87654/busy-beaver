BB12_M12_bound.sym_val =
fun s : Sym => match s with
               | 0 => 0
               | 1 => 1
               end
     : Sym -> nat

Arguments BB12_M12_bound.sym_val s%sym_scope
BB12_M12_bound.count1 =
fix count1 (xs : list Sym) : nat :=
  match xs with
  | []%list => 0
  | (x :: t)%list => BB12_M12_bound.sym_val x + count1 t
  end
     : list Sym -> nat

Arguments BB12_M12_bound.count1 xs%list_scope
BB12_M12_bound.ones =
fun (c : Q * tape) (N : nat) =>
exists (q : Q) (L R : list Sym) (s : Sym),
  c = (q, (L *> const 0, s, R *> const 0)) /\
  N =
  BB12_M12_bound.count1 L + BB12_M12_bound.sym_val s +
  BB12_M12_bound.count1 R
     : Q * tape -> nat -> Prop

Arguments BB12_M12_bound.ones c N%nat_scope
BB12_M12.halt
     : halts BB12_M12.tm c0
BB12_M12_bound.score_exact
     : exists c : Q * tape,
         c0 -[ BB12_M12.tm ]->* c /\
         halted BB12_M12.tm c /\
         BB12_M12_bound.ones c (fst BB12_M12.pb2 + snd BB12_M12.pb2 / 2 + 3)
BB12_M12_bound.sigma_lower_bound_strong
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB12_M12.tm ]->* c /\
         halted BB12_M12.tm c /\
         BB12_M12_bound.ones c N /\
         BB12_M12_bound.f_omega2 (BB12_M12_bound.f_omega 20) < N + 1
BB12_M12_bound.sigma_lower_bound_m12
     : exists (c : Q * tape) (N : nat),
         c0 -[ BB12_M12.tm ]->* c /\
         halted BB12_M12.tm c /\
         BB12_M12_bound.ones c N /\
         BB12_M12_bound.f_omega2
           (BB12_M12_bound.f_omega1 (BB12_M12_bound.f_omega1 3)) < 
         N + 1
